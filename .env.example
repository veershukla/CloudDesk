# CloudDesk - environment template (CLAUDE.md §10.1)
# Copy to .env and fill in values. Placeholders only - never put a real key in this file.
# get_settings() is cached: restart the server after editing .env.

# --- Runtime ---
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
SAMPLE_DATA_DIR=./sample_data

# --- Auth (HS256). SUPABASE_JWT_SECRET wins when set. ---
JWT_SECRET=change-me-local-dev-only
SUPABASE_JWT_SECRET=

# --- Database ---
# Demo: sqlite+aiosqlite:///./data/support.db
# Cloud: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./data/support.db

# --- LangGraph checkpointer (:memory: in tests) ---
CHECKPOINT_DB_PATH=./data/checkpoints.db

# --- Redis (empty -> fakeredis) ---
REDIS_URL=
USE_FAKE_REDIS=false

# --- LLM (fake runs offline with no key) ---
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (changing the model requires POST /knowledge/reindex) ---
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# --- Vector store: memory | qdrant ---
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

# --- Tool policy ---
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=10

# --- Rate limit (requests per client per minute) ---
RATE_LIMIT_PER_MINUTE=120

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
